# React app — copy to `.env.local` for local development
REACT_APP_API_BASE_URL=http://localhost:8080
# Razorpay Checkout (publishable key — safe in browser; never put key secret here)
REACT_APP_RAZORPAY_KEY_ID=

# Spring Boot (server-side only — not prefixed with REACT_APP)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
